# ==============================================================================
# .env.example — AskCare Backend Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# ==============================================================================

PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Gmail SMTP Settings (for OTP email authentication)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Generate a 16-character Google App Password:
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your-email@gmail.com

# ── Local Ollama Model (for local development) ──────────────────────────
SMOLLM_API_KEY=not_needed
SMOLLM_API_URL=http://localhost:11434/v1/chat/completions
SMOLLM_MODEL_NAME=askcare-medical

# ── Custom Model (Render-hosted Ollama for 24/7 production) ─────────────
# Set USE_CUSTOM_MODEL=true AFTER deploying the Ollama service to Render.
# Then replace CUSTOM_MODEL_URL with your actual Render service URL.
USE_CUSTOM_MODEL=false
CUSTOM_MODEL_URL=https://your-ollama-service.onrender.com/v1/chat/completions
CUSTOM_MODEL_NAME=askcare-medical

# ── Mistral AI (Mistral Small 4) ─────────────────────────────────────────
# Get your API key from: https://console.mistral.ai/api-keys/
mistral_api=your_mistral_api_key_here
MISTRAL_MODEL_NAME=mistral-small-2603
