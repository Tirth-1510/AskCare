# ==============================================================================
# Dockerfile.ollama — AskCare Ollama Inference Server (Render-compatible)
# ==============================================================================
FROM ollama/ollama:latest

# Copy the Modelfile that defines the custom model
COPY Modelfile /root/Modelfile

# Copy the training dataset
COPY medical_dataset.jsonl /root/medical_dataset.jsonl

# Copy the startup script and fix Windows CRLF line endings
COPY start.sh /root/start.sh
RUN sed -i 's/\r$//' /root/start.sh && chmod +x /root/start.sh

# Render sets PORT dynamically (usually 10000)
EXPOSE 10000

ENTRYPOINT ["/root/start.sh"]
